{
  "name": "minhage",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:db:up": "bash scripts/test-db.sh up",
    "test:db:down": "bash scripts/test-db.sh down",
    "test:backend": "MONGO_TEST_URI=\"$(bash scripts/test-db.sh up)\" pnpm --filter backend test",
    "test:sandbox": "MONGO_TEST_URI=\"$(bash scripts/test-db.sh up)\" pnpm -r run test",
    "build": "pnpm -r run build",
    "dev:local": "bash scripts/dev-local.sh",
    "db:clean": "docker compose down -v --remove-orphans && docker compose -f docker-compose.dev.yml down -v --remove-orphans"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
